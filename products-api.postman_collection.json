            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/products/getAll?active=TRUE",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "products",
            "getAll"
          ],
          "query": [
            {
              "key": "active",
              "value": "TRUE"
            }
          ]
        },
        "description": ""
      },
      "response": []
    },
