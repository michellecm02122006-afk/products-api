            "api",
            "v1",
            "products",
            "create"
          ]
        },
        "description": "Cuerpo: name, price, stock, description, brand, img",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Monitor 24\\\"\",\n  \"price\": 2499.99,\n  \"stock\": 10,\n  \"description\": \"Monitor IPS Full HD\",\n  \"brand\": \"Dell\",\n  \"img\": \"https://example.com/monitor.jpg\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.data && j.data.id) pm.collectionVariables.set('id', j.data.id);"
            ]
          }
        }
      ]
    },
